<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>NeoMindStd</Company>
    <Authors>NeoMindStd</Authors>
    <Product>Sparring</Product>
    <Description>Local StarCraft 1.16.1 BWAPI AI sparring launcher</Description>
    <Copyright>Copyright (c) NeoMindStd</Copyright>
    <PackageProjectUrl>https://github.com/NeoMindStd/SPArring</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NeoMindStd/SPArring</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
